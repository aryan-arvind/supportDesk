# Server Port Configuration
PORT=8001

# Database Configuration (Falls back to local SQLite tickets.db if missing)
# DATABASE_URL=postgresql://user:password@host:port/database

# Inbound Email Sync (Testmail.app Integration)
# Register a free account at https://testmail.app to get your keys:
TESTMAIL_API_KEY=your_api_key_here
TESTMAIL_NAMESPACE=your_namespace_here
